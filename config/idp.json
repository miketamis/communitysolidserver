{
  "@context": "https://linkedsoftwaredependencies.org/bundles/context.jsonld",
  "@type": "ServerInitializer",
  "identifier": "urn:solid:server:default",
  "components": [
    {
      "@type": "CliRunner",
      "mainModulePath": "./",
      "configFile": "config/default.json"
    },
    {
      "@type": "BaseUrlExtractor",
      "baseUrl": "https://communitysolidserver-production.up.railway.app/",
      "allowForwardedHost": true
    },
    {
      "@type": "IdentityProviderInitializer",
      "settings": {
        "baseUrl": "https://communitysolidserver-production.up.railway.app",
        "enablePasswordRegistration": true
      }
    }
  ]
}